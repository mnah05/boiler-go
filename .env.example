# ---------- server ----------
APP_HOST=127.0.0.1
APP_PORT=8080

# ---------- database ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appdb?sslmode=disable

# ---------- redis cache (optional) ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- database pool ----------
DB_MAX_CONNS=15
DB_MAX_IDLE_CONNS=5
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

# ---------- redis pool ----------
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
# Cache starts in degraded mode when Redis is unavailable and probes again at
# this interval.
REDIS_RECONNECT_INTERVAL=10s

# ---------- email (optional Resend integration) ----------
# Set both values to enable mailer.ResendSender. Leave both blank in local dev.
RESEND_API_KEY=
RESEND_FROM=

# ---------- timeouts ----------
HEALTH_CHECK_TIMEOUT=2s
API_SHUTDOWN_TIMEOUT=10s

# ---------- logging ----------
# "stdout" = JSON to console (default, good for production)
# "file" = write to file only
# "both" = write to file AND console
LOG_OUTPUT=stdout

# Log level: debug, info (default), warn, error
LOG_LEVEL=info

# Log file path (only used when LOG_OUTPUT is "file" or "both")
# Examples: logs/api.log, /var/log/myapp/app.log
LOG_FILE=

# ---------- security (Clerk) ----------
# Clerk secret key for session verification (Clerk Dashboard -> API keys).
CLERK_SECRET_KEY=sk_test_...
# Svix signing secret for the Clerk webhook endpoint (Clerk Dashboard -> Webhooks).
CLERK_WEBHOOK_SECRET=whsec_...

# Enable HSTS header (default: false). Only enable in production with HTTPS.
SECURITY_HSTS_ENABLED=false
